{
  "$schema": "./json-schemas/ng/cli/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "yarn",
    "analytics": "96635761-6323-4004-8cda-37b4e7d228df"
  },
  "newProjectRoot": "projects",
  "projects": {
    "myapp": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/myapp",
      "sourceRoot": "projects/myapp/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser-esbuild",
          "options": {
						"baseHref": "/blaze-integrator-app/",
            "outputPath": "dist/myapp",
            "index": "projects/myapp/src/index.html",
            "main": "projects/myapp/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/myapp/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/myapp/src/favicon.ico",
              "projects/myapp/src/assets",
              {
                "glob": "**/*",
                "input": "./node_modules/@clay/ui-commons/assets",
                "output": "/assets/"
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules/@clay/ui-commons/styles",
                "node_modules/@clay/app-shell/styles",
                "node_modules/@clay/tailwind-preset/styles"
              ]
            },
            "styles": [
              "node_modules/@clay/ui-commons/styles/main.scss",
              "node_modules/@clay/ui-commons/styles/vendors.scss",
              "node_modules/@clay/app-shell/styles/splash-screen.css",
              "node_modules/@clay/tailwind-preset/styles/themes.scss",
              "node_modules/@clay/tailwind-preset/styles/user-themes.scss",
              "node_modules/@clay/tailwind-preset/styles/tailwind.scss",
              "projects/myapp/src/styles/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "8mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "5mb",
                  "maximumError": "10mb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/myapp/src/environments/environment.ts",
                  "with": "projects/myapp/src/environments/environment.prod.ts"
                }
              ],
              "buildOptimizer": true,
              "optimization": true,
              "extractLicenses": false,
              "sourceMap": false,
              "namedChunks": true,
              "allowedCommonJsDependencies": [
                "apexcharts",
                "highlight.js",
                "crypto-js/enc-utf8",
                "crypto-js/hmac-sha256",
                "crypto-js/enc-base64",
                "flat",
                "lodash"
              ]
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "allowedCommonJsDependencies": [
                "apexcharts",
                "highlight.js",
                "crypto-js/enc-utf8",
                "crypto-js/hmac-sha256",
                "crypto-js/enc-base64",
                "flat",
                "lodash"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "myapp:build:production"
            },
            "development": {
              "buildTarget": "myapp:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "myapp:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/myapp/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/myapp/src/favicon.ico",
              "projects/myapp/src/assets"
            ],
            "styles": [
              "node_modules/@clay/ui-commons/styles/main.scss",
              "node_modules/@clay/ui-commons/styles/vendors.scss",
              "node_modules/@clay/app-shell/styles/splash-screen.css",
              "node_modules/@clay/tailwind-preset/styles/themes.scss",
              "node_modules/@clay/tailwind-preset/styles/user-themes.scss",
              "node_modules/@clay/tailwind-preset/styles/tailwind.scss",
              "projects/myapp/src/styles/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
